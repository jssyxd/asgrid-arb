[Unit]
Description=NautilusTrader Live MM DOGE-USDT (accountbot4)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nautilus_cluster/services/02_as_grid_doge_accountbot4
ExecStart=/opt/nautilus_cluster/venv/bin/python /opt/nautilus_cluster/services/02_as_grid_doge_accountbot4/run_doge.py
Restart=always
RestartSec=5
MemoryMax=350M
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONMALLOC=malloc

[Install]
WantedBy=multi-user.target
